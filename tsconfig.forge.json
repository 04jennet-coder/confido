{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "forge/src/lib",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/core/**/*.ts", "src/adapters/jiraMap.ts"]
}
